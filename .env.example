# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-token

# Comma-separated admin user ids (optional)
ADMIN_IDS=

# Run browser in GUI mode (not headless). Better for bypassing anti-bot detection.
# On server use: xvfb-run -a python bot.py (virtual display, no real window)
HEADLESS=false

# Use an installed browser instead of bundled chromium: chrome | msedge | chromium
# chrome = more reliable for PWA installation and anti-bot evasion
BROWSER_CHANNEL=chrome

# How many days to collect pushes before sending the pack
COLLECT_DAYS=7

# Max simultaneously running browser sessions
MAX_SESSIONS=20

# How often (minutes) the scheduler checks for finished sessions
SWEEP_MINUTES=10

# Storage
DB_PATH=data/bot.sqlite3
PROXIES_FILE=proxies.json
SESSIONS_DIR=data/sessions

# QA/Testing: if your PWA cloaking has a backdoor, set QA_TOKEN
# Bot will append ?qa=<token> to the URL to bypass anti-bot checks
QA_TOKEN=

# Two access tiers, both unlocked with /unlock <key>:
#   ACCESS_KEY → "scan" tier: only "🔎 Сканер PWA"
#   PUSH_KEY   → "push" tier: everything, incl. push collection
# Empty ACCESS_KEY → the whole bot is open to everyone.
# Empty PUSH_KEY   → anyone who has scan access also gets push.
ACCESS_KEY=
PUSH_KEY=

# A collecting session idles proxyless (pushes ride the FCM connection); the
# scan proxy is re-attached only while the live browser is open, so you don't
# pay for the proxy 24/7.

# Live browser control (screencast) web server.
# WEBCONTROL_HOST/PORT — where the bot binds it (internal; Caddy is the only
# thing that talks to it directly, see docker-compose.yml).
# PUBLIC_DOMAIN — your domain, pointed at this server's IP (an A record).
# Caddy uses it to request a Let's Encrypt cert automatically and serves the
# live-browser panel over HTTPS/WSS on ports 80/443.
# PUBLIC_URL — what the bot puts in links it sends you; must be
# https://<PUBLIC_DOMAIN> to match.
#
# Plain HTTP/WS (no domain) used to work but some networks — a phone's
# carrier or a home router's traffic-inspection — silently strip the
# WebSocket Upgrade header on unencrypted, non-standard-port traffic,
# breaking the live browser with no visible error. HTTPS/WSS encrypts the
# handshake so that can't happen. On a local machine (no domain, testing
# only) leave PUBLIC_URL as http://localhost:8080 and skip Caddy.
WEBCONTROL_HOST=0.0.0.0
WEBCONTROL_PORT=8080
PUBLIC_DOMAIN=bot.example.com
PUBLIC_URL=https://bot.example.com
